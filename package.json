{
  "name": "coni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "gunicorn coni_backend.wsgi:application --bind 0.0.0.0:$PORT",
    "dev": "python manage.py runserver 127.0.0.1:8000",
    "mcp": "python mcp/operations_server.py",
    "db:migrate": "python manage.py migrate",
    "check": "python manage.py check --deploy",
    "legacy:node": "node backend/server.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "tweetnacl": "^1.0.3",
    "viem": "^2.37.4"
  }
}
