# Private signer service variables. Store real values only in the signer
# service secret manager; never copy them into the browser or public Django env.
SIGNER_SHARED_SECRET=replace-with-32-or-more-random-characters
SIGNER_DATABASE_URL=postgresql://signer_user:password@private-postgres:5432/coni_signer
# Separate private audit database. The service only appends chained events;
# keep the production role from UPDATE/DELETE and export it to immutable WORM
# storage for independent review.
SIGNER_AUDIT_DATABASE_URL=postgresql://audit_user:password@private-audit-postgres:5432/coni_signer_audit
SIGNER_AUDIT_HMAC_KEY=replace-with-a-separate-32-or-more-random-secret
CONI_EXECUTION_MODE=disabled
CONI_SIGNER_AUDIT_APPROVED=false
SIGNER_ALLOWED_RECIPIENTS={"ethereum":[],"base":[],"robinhood":[],"bsc":[],"solana":[]}
SIGNER_MAX_VALUE_BASE_UNITS=0
SIGNER_MAX_TOTAL_VALUE_BASE_UNITS=0
SIGNER_REQUIRED_APPROVALS=2
# JSON map of approver ID to base64 Ed25519 public key.
SIGNER_APPROVER_KEYS={}
# Real HSM/MPC adapter reachable only over private HTTPS/mTLS.
SIGNER_ADAPTER_URL=https://hsm-adapter.private.example
SIGNER_ADAPTER_CA_FILE=/run/secrets/adapter-ca.pem
SIGNER_ADAPTER_CLIENT_CERT=/run/secrets/signer-client.pem
SIGNER_ADAPTER_CLIENT_KEY=/run/secrets/signer-client-key.pem
# Additional request authentication. Keep this different from every Django,
# signer, and MPC credential. The adapter still requires mTLS.
SIGNER_ADAPTER_SHARED_SECRET=replace-with-a-separate-32-or-more-random-secret
SIGNER_ADAPTER_TIMEOUT_SECONDS=5
# Fee/withdrawal key references are created inside the custody provider. The
# Django CONI_SIGNER_FEE_KEY_REFS values must exactly match those identifiers;
# never place private keys, seeds, or shares in this file.
# Private Django callback transport used by the custody adapter worker.
# The web service must define PORT=8000 in Railway so this private port is
# stable. Use the encrypted private-network hostname; never use the public
# domain here.
SIGNER_DJANGO_API_URL=http://coni-web.railway.internal:8000
CONI_SIGNER_PROVISION_SECRET=replace-with-a-separate-32-or-more-random-secret
CONI_SIGNER_EVENT_SECRET=replace-with-a-separate-32-or-more-random-secret
# The private provisioning worker is off by default. Enable only after the
# coordinator's DKG/provisioning endpoint and recovery controls are reviewed.
SIGNER_PROVISIONING_ENABLED=false
SIGNER_PROVISIONING_POLL_SECONDS=15
SIGNER_DJANGO_TIMEOUT_SECONDS=10
# Separate secret used to derive a stable per-request protocol nonce. It is
# not a wallet key or key share and must not be reused as another credential.
CONI_SIGNER_PROVISION_SESSION_KEY=replace-with-a-separate-32-or-more-random-secret
# Evidence references are operator-supplied identifiers, not proof by
# themselves. Keep the underlying reports in an immutable restricted store.
SIGNER_CUSTODY_POLICY_ID=
SIGNER_KEY_CEREMONY_ID=
SIGNER_RECOVERY_DRILL_ID=
SIGNER_SECURITY_REVIEW_ID=
SIGNER_APPROVAL_POLICY_ID=
SIGNER_AUDIT_SINK_ID=
