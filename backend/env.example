DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=laki-production.up.railway.app
CONI_ALLOWED_ORIGINS=https://laki-production.up.railway.app
# If the private Chrome extension performs authenticated API calls, add its
# exact installed origin, for example:
# CONI_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnop
CONI_EXTENSION_ORIGINS=
DATABASE_URL=postgresql://user:password@caboose.proxy.rlwy.net:15217/railway
DATABASE_SSL=require
CONI_AUTH_DOMAIN=coni.example
CONI_AUTH_URI=https://coni.example
CONI_OPS_TOKEN=replace-with-a-separate-operations-token
CONI_EXECUTION_MODE=disabled
# Live mode additionally requires a signer adapter and an explicit confirmation string.
CONI_SIGNER_URL=
# Private signer-to-Django callback secret. Keep this out of the browser and
# use private networking/mTLS as well; it never carries a private key.
CONI_SIGNER_PROVISION_SECRET=
# Separate private callback secret for post-signing/reconciliation events.
CONI_SIGNER_EVENT_SECRET=
# Private callbacks must use HMAC(timestamp + "." + exact request body) in
# X-Coni-Signer-Signature and X-Coni-Signer-Timestamp in production.
CONI_SIGNER_CALLBACK_REQUIRE_HMAC=true
CONI_SIGNER_CALLBACK_MAX_SKEW_SECONDS=60
CONI_LIVE_TRADING_CONFIRMATION=
CONI_SIGNER_AUDIT_APPROVED=false
# Explicitly enable only after the private signer, approval policy, and audit
# evidence have been reviewed. User withdrawals are never auto-approved.
CONI_WITHDRAWAL_APPROVALS_ENABLED=false
CONI_SIGNER_WITHDRAWAL_KEY_REFS={"ethereum":"hsm/withdrawal-ethereum","base":"hsm/withdrawal-base","robinhood":"hsm/withdrawal-robinhood","bsc":"hsm/withdrawal-bsc","solana":"hsm/withdrawal-solana"}
CONI_SIGNER_FEE_KEY_REFS={"ethereum":"hsm/fee-ethereum","base":"hsm/fee-base","robinhood":"hsm/fee-robinhood","bsc":"hsm/fee-bsc","solana":"hsm/fee-solana"}
# These are opaque labels resolved by the private signer/MPC service, not
# private keys and not automatically-created vault paths. The signer must map
# each label to a protected fee key whose public address matches above.
# Optional aggregate cap; if omitted, the per-step cap is also the total cap.
SIGNER_MAX_TOTAL_VALUE_BASE_UNITS=0
# Set to 2 only when the HSM/MPC provider independently verifies two approvers.
SIGNER_REQUIRED_APPROVALS=0
CONI_DEFAULT_COST_BUFFER_BPS=55
CONI_TRADING_FEE_BPS=10
# Pangea can set 0.3% to 5% per launch. Use the maximum until the exact
# launch fee is independently loaded into the server-side registry.
CONI_DEFAULT_LAUNCH_FEE_BPS=500
CONI_BOT_FUNDING_FEE_BPS=10
CONI_BOT_WITHDRAWAL_FEE_BPS=10
CONI_WITHDRAWAL_FEE_BPS=10
# JSON object. Keep this in the secret manager, never in the frontend.
CONI_FUNDING_RECIPIENTS={"ETH":"","BNB":"","SOL":""}
# Optional chain-specific override. This is safer for tokens and multi-chain treasury addresses.
CONI_DEPOSIT_RECIPIENTS={"ZGAP":{"ethereum":"","base":"","robinhood":"","bsc":"","solana":""}}
# Fee recipients are separate from deposit recipients. Supply reviewed, chain-specific addresses.
# 10 bps = 0.1%; missing recipients fail closed when the fee is non-zero.
CONI_FEE_RECIPIENTS={"ETH":{"ethereum":"","base":"","robinhood":""},"BNB":{"bsc":""},"SOL":{"solana":""},"ZGAP":{"ethereum":"","base":"","robinhood":"","bsc":"","solana":""}}
# Token addresses and verified decimals are server-side configuration, not frontend authority.
CONI_TOKEN_REGISTRY={"ZGAP":{"ethereum":{"address":"0xdbA134AD399e15D9175CE6bC97BEcA7001Fb96eA","decimals":null},"base":{"address":"0xdbA134AD399e15D9175CE6bC97BEcA7001Fb96eA","decimals":null},"robinhood":{"address":"0xdbA134AD399e15D9175CE6bC97BEcA7001Fb96eA","decimals":null},"bsc":{"address":"0xdbA134AD399e15D9175CE6bC97BEcA7001Fb96eA","decimals":null},"solana":{"address":"5KtxmGhFfy6QaoU3Qtu2ouweqq1qfXfNZHg3CJH7y6ea","decimals":null}}}
# Before enabling token funding, run `python manage.py verify_asset_registry`.
# It must report ready=true against the private RPCs; do not fill decimals from
# the browser or from an unverified token website.
# Server-side RPC endpoints. Keep credentials out of GitHub and frontend code.
CONI_RPC_URLS={"ethereum":["https://your-ethereum-node.internal"],"base":["https://your-base-node.internal"],"robinhood":["https://your-robinhood-node.internal"],"bsc":["https://your-bsc-node.internal"]}
CONI_EXPECTED_CHAIN_IDS={"ethereum":"0x1","base":"0x2105","robinhood":"0x1237","bsc":"0x38"}
CONI_SOLANA_RPC_URL=https://your-solana-node.internal
CONI_DEPOSIT_CONFIRMATIONS=12
CONI_DEPOSIT_MAX_AGE_MINUTES=1440
CONI_DEPOSIT_SCAN_BATCH=50
CONI_DEPOSIT_SCAN_LOOKBACK_BLOCKS=2000
# Compare active attested bot-wallet balances with finalized/latest private RPC
# reads during reconcile_ledger. Keep enabled in production; it reports
# mismatches and never mutates a ledger or credits funds.
CONI_RECONCILE_ONCHAIN_BALANCES=true
CONI_REDIS_URL=redis://default:<redis-password>@<redis-host>:<redis-port>
CONI_REDIS_REQUIRED=true
CONI_PANGEA_CONNECT_TIMEOUT_SECONDS=3.05
CONI_PANGEA_READ_TIMEOUT_SECONDS=6
# Optional logo/name enrichment must never block the live pool feed.
CONI_PANGEA_LAUNCH_FEED_TIMEOUT_SECONDS=2
# Launch metadata is cached briefly; /pools remains fetched fresh for every scan.
CONI_PANGEA_LAUNCH_FEED_CACHE_SECONDS=15
# Optional server-side supplementary discovery feed. Keep disabled until a
# Motion msk_ key is issued; never expose MOTION_API_KEY to browser code.
CONI_MOTION_ENABLED=false
MOTION_API_KEY=replace-with-motion-msk-key
CONI_MOTION_API_URL=https://motion.gift/api/v1
CONI_MOTION_CONNECT_TIMEOUT_SECONDS=3.05
CONI_MOTION_READ_TIMEOUT_SECONDS=6
CONI_MOTION_CACHE_SECONDS=300
CONI_MOTION_MAX_LIMIT=20
CONI_AUDIT_HASH_KEY=<random-audit-key>
CONI_ARBITRAGE_NOTIONAL_USD=10
CONI_ARBITRAGE_MIN_NET_BPS=100
CONI_ARBITRAGE_MIN_PROFIT_USD=0.05
CONI_ARBITRAGE_MAX_NOTIONAL_USD=25
CONI_ARBITRAGE_RISK_BUFFER_BPS=75
# Required before execution planning. JSON map of chain to native base units;
# include gas and expected bridge-native fees. Empty keeps the planner inert.
CONI_ARBITRAGE_NATIVE_RESERVE_BASE_UNITS={}
CONI_ARBITRAGE_SLIPPAGE_BPS=100
# Keep true in production. False is only for displaying indicative spreads in a local paper dashboard.
CONI_ARBITRAGE_REQUIRE_QUOTES=true
CONI_ARBITRAGE_MAX_BRIDGE_SECONDS=120
CONI_ARBITRAGE_MAX_QUOTE_REQUESTS=20
CONI_ARBITRAGE_SCAN_INTERVAL_SECONDS=10
CONI_ARBITRAGE_QUOTE_INTERVAL_SECONDS=5
CONI_ARBITRAGE_PLAN_INTERVAL_SECONDS=5
# 0 means enumerate every valid cross-chain direction from /api/pools.
CONI_ARBITRAGE_MAX_CANDIDATES=0
CONI_ARBITRAGE_MAX_QUOTE_AGE_SECONDS=5
CONI_ARBITRAGE_MAX_PRICE_MOVE_BPS=200
CONI_ARBITRAGE_MAX_MARKET_CAP_MOVE_BPS=2000
# Keep true in production; set false only for paper mode if the Pangea feed
# does not expose an explicit marketCapUsd field for a token.
CONI_ARBITRAGE_REQUIRE_MARKET_CAP_DATA=true
CONI_ARBITRAGE_MIN_DEPTH_MULTIPLE=3
CONI_ARBITRAGE_MAX_PRICE_IMPACT_BPS=100
CONI_ARBITRAGE_MIN_BRIDGE_RETENTION_BPS=9900
CONI_ARBITRAGE_MIN_CONFIDENCE_BPS=8500
CONI_DEFAULT_COMPOUND_PROFIT_BPS=7000
# Required in production for bot-wallet withdrawals. Keys use chain:asset;
# values are integer base-unit caps for one transfer and a rolling 24-hour sum.
CONI_BOT_WITHDRAWAL_LIMITS_REQUIRED=true
CONI_BOT_WITHDRAWAL_LIMITS={"base:ETH":{"perTransferBaseUnits":"100000000000000000","dailyBaseUnits":"500000000000000000"},"ethereum:ETH":{"perTransferBaseUnits":"100000000000000000","dailyBaseUnits":"500000000000000000"},"robinhood:ETH":{"perTransferBaseUnits":"100000000000000000","dailyBaseUnits":"500000000000000000"},"bsc:BNB":{"perTransferBaseUnits":"100000000000000000","dailyBaseUnits":"500000000000000000"},"solana:SOL":{"perTransferBaseUnits":"100000000","dailyBaseUnits":"500000000"}}
# Optional comma-separated worker override; the Railway worker service uses all defaults.
CONI_WORKER_COMMANDS=scan_arbitrage,quote_arbitrage_opportunities,verify_deposits,reconcile_ledger,plan_arbitrage_executions,queue_profit_settlements
# Server-side addresses used only to request read-only Pangea quotes. Never put private keys here.
CONI_BOT_WALLETS={"ethereum":"","base":"","robinhood":"","bsc":"","solana":""}
# Coni profit destination. Verify USDG's Robinhood Chain contract and decimals independently before enabling.
CONI_PROFIT_SETTLEMENT_ENABLED=false
CONI_PROFIT_SETTLEMENT_ASSET=USDG
CONI_PROFIT_SETTLEMENT_CHAIN=robinhood
CONI_PROFIT_SETTLEMENT_TOKEN_ADDRESS=
CONI_PROFIT_SETTLEMENT_DECIMALS=
# Explicit verified USDG USD price used only to prepare payout instructions;
# leave blank until the operator has a current, independently verified price.
CONI_PROFIT_SETTLEMENT_PRICE_USD=
